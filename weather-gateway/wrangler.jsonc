{
  "name": "weather-gateway",
  "main": "src/index.mjs",
  "compatibility_date": "2026-09-12",
  "keep_vars": true,
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "PUBLIC_ORIGIN": "https://weather.astronet.com.ar",
    "ORIGIN_URL": "https://weather-origin.astronet.com.ar"
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "AUTH",
        "class_name": "WeatherAuth"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "WeatherAuth"
      ]
    }
  ],
  "observability": {
    "enabled": false
  }
}
